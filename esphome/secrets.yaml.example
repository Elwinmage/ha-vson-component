# Copy to secrets.yaml and fill in. Never commit the real secrets.yaml.
wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# API encryption key — generate one with `openssl rand -base64 32`,
# or let ESPHome suggest it when you adopt the device.
api_encryption_key: "GENERATE_A_32_BYTE_BASE64_KEY"

# Fallback hotspot password (AP mode when WiFi is unavailable), min 8 chars.
ap_password: "changeme-ap-pass"
